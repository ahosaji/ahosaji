# Production serving environment: no master/indexing or migration credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DATABASE_URL=
MEILISEARCH_HOST=
MEILISEARCH_SEARCH_KEY=
# Host-native Caddy only; change for the actual trusted deployment network.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
