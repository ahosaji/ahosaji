# Local development only. Copy to .env; never commit real credentials.
# Production API and ingestion must use separate environments (see DEPLOY.md).
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgres://ahosaji:ahosaji-local-dev-only@127.0.0.1:5433/ahosaji
MEILISEARCH_HOST=http://127.0.0.1:7701
# This explicit master-key fallback is development-only.
MEILISEARCH_MASTER_KEY=ahosaji-local-dev-only-master-key-32-chars
ALLOW_MEILISEARCH_MASTER_KEY_FALLBACK=true
MEILISEARCH_SEARCH_KEY=
# Direct local server: leave empty. Caddy on the host uses loopback CIDRs.
# Deployed proxy values must match its actual immediate source addresses.
TRUSTED_PROXY_CIDRS=
# Set approved endpoints explicitly; no provider or local file is assumed.
SOURCE_BASE_URL=
SOURCE_VERSION=
AR_BASE_URL=
AR_USER_AGENT=Ahosaji-ingestion/0.1 (set an appropriate contact before scraping)
SOURCE_PDF_PATH=
# Optional interpreter; otherwise the project virtualenv or python3 is used.
PYTHON_BIN=
FIRECRAWL_API_KEY=
