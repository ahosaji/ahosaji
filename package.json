{
  "name": "ahosaji",
  "private": true,
  "version": "0.0.0",
  "description": "Ahosaji \u2014 Coptic Orthodox content API (Treasure of the Word)",
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": ">=9.12.0 <10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @ahosaji/ingest dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:python": "python3 -B -m unittest discover -s ingest/test -p 'test_python_*.py'",
    "validate": "pnpm --filter @ahosaji/ingest validate"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.0"
}
