{
  "name": "@ahosaji/sdk",
  "private": true,
  "version": "0.1.0",
  "description": "Ahosaji TypeScript SDK \u2014 auto-generated from OpenAPI",
  "type": "module",
  "main": "./src/generated/index.ts",
  "types": "./src/generated/index.ts",
  "scripts": {
    "generate": "openapi --input ../../docs/api/openapi.yaml --output src/generated --name AhosajiClient --client fetch --useOptions --useUnionTypes",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/smoke.ts",
    "docs": "typedoc --options typedoc.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript-codegen": "^0.29.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
